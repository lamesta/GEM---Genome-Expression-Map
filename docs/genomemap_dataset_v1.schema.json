{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genomemap-dataset-v1",
  "title": "genomemap dataset v1",
  "type": "object",
  "required": ["format", "version", "replicons", "features", "contrasts", "log2fc", "meta"],
  "properties": {
    "format": {"const": "genomemap-dataset"},
    "version": {"const": 1},
    "title": {"type": "string"},
    "organism": {"type": "string"},
    "strain": {"type": "string"},
    "replicons": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "length"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"},
                     "length": {"type": "integer", "minimum": 1},
                     "topology": {"enum": ["circular", "linear"]}}}},
    "features": {"type": "object", "required": ["id", "rep", "s", "e", "st", "type"],
      "properties": {
        "id": {"type": "array", "items": {"type": "string"}},
        "rep": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "s": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "e": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "st": {"type": "array", "items": {"enum": [1, -1, 0]}},
        "type": {"type": "array", "items": {"type": "string"}},
        "gene": {"type": "array", "items": {"type": "string"}},
        "product": {"type": "array", "items": {"type": "string"}},
        "cog": {"type": "array", "items": {"type": "string"}},
        "cogcat": {"type": "array", "items": {"type": "string"}},
        "group": {"type": "array", "items": {"type": "string"}}}},
    "libraries": {"type": "array", "items": {"type": "object", "required": ["id"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "condition": {"type": "string"},
                     "replicate": {}, "batch": {"type": "string"}}}},
    "normalized": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": ["number", "null"]}}},
    "expressed": {"type": "array", "items": {"type": "boolean"}},
    "contrasts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "kind", "role"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "short": {"type": "string"},
                     "treatment": {"type": "array", "items": {"type": "string"}},
                     "control": {"type": "array", "items": {"type": "string"}},
                     "kind": {"enum": ["descriptive", "statistical"]},
                     "role": {"enum": ["test", "reference"]},
                     "source": {"type": "string"}}}},
    "log2fc": {"type": "array", "items": {"type": "array", "items": {"type": ["number", "null"]}}},
    "padj": {"type": "array", "items": {"type": ["array", "null"], "items": {"type": ["number", "null"]}}},
    "basemean": {"type": "array", "items": {"type": ["array", "null"], "items": {"type": ["number", "null"]}}},
    "landmarks": {"type": "array", "items": {"type": "object", "required": ["name", "rep", "s", "e"],
      "properties": {"name": {"type": "string"}, "rep": {"type": "integer"}, "s": {"type": "integer"}, "e": {"type": "integer"},
                     "type": {"type": "string"}, "color": {"type": "string"}, "label": {"type": "string"}}}},
    "labels": {"type": "object", "additionalProperties": {"type": "object",
      "properties": {"label": {"type": "string"}, "note": {"type": "string"}}}},
    "meta": {"type": "object", "required": ["mode"],
      "properties": {"mode": {"enum": ["A", "B"]}, "normalization": {"type": "string"}, "size_factor_variant": {"enum": ["standard", "zero_tolerant", "none"]},
                     "size_factors": {"type": "object"}, "filter": {"type": "string"}, "pseudocount": {"type": "number"},
                     "created": {"type": "string"}, "software": {"type": "string"},
                     "inputs": {"type": "array"}, "warnings": {"type": "array", "items": {"type": "string"}}}}
  }
}
